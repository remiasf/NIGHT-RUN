generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL") 
}

enum CarType {
  RALLY
  CIVIL
  TRACK
  TOUGE
}

model User {
  id        String   @id @default(uuid())
  firebaseUid String @unique
  email     String   @unique
  login     String
  cars      Car[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Car {
  id            String   @id @default(uuid())

  brand         String
  model         String
  year          Int

  description   String

  carType       CarType

  slug          String   @unique
  price         Int
  originalPrice Int?

  modelUrl      String?
  imageUrl      String?

  scale         Float    @default(1.0)
  positionY     Float    @default(0.0)
  rotationY     Float    @default(0.0)

  environment   String   @default("city")
  
  engine        String?
  engineType    String
  engineCode    String?
  hp            Int?
  torque        Int?
  displacement  Float?
  
  transmission  String?
  driveType     String
  zeroToHundred Float?
  topSpeed      Int?
  weight        Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id])
}